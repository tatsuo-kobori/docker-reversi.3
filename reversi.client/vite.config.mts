          // 正規表現をより柔軟にし、改行やスペース、属性の順序に関わらずfont/eotのプレロードを消去
          return html.replace(/<link\s+[^>]*rel=["']preload["'][^>]*type=["']font\/eot["'][^>]*>/gi, '')
        }
      }
    }
