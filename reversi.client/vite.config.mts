          name: 'Roboto',
          styles: 'wght@100;300;400;500;700;900',
        }],
      },
    }),
    {
      name: 'remove-eot-preload',
      enforce: 'post', // 💡 他の全てのプラグインがHTMLを処理した「後」に実行させる
